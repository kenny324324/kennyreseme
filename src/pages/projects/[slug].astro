---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import { projectDetails, getAllProjectSlugs, type ProjectDetail } from '../../data/projectDetails';

export function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map(slug => ({
    params: { slug },
    props: { project: projectDetails[slug] }
  }));
}

interface Props {
  project: ProjectDetail;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${project.title} - 余亮廷 Kenny Yu`} description={project.description}>
  <Navbar showBackButton={true} />

  <main class="project-details pt-[100px] pb-[60px] bg-[#F6F6F6] min-h-screen">
    <div class="container max-w-[1200px] mx-auto px-5">
      <!-- Header -->
      <div class="section-header text-left mb-[60px] relative">
        <h1 class="section-title text-[3rem] md:text-[3.5rem] font-bold text-[#2B2B2B] mb-2 tracking-tight leading-tight">
          {project.title}
        </h1>
        {project.subtitle && (
          <p class="text-xl text-[#6A6A6A] font-medium">{project.subtitle}</p>
        )}
      </div>

      <!-- Main Content -->
      <div class="project-content grid grid-cols-1 lg:grid-cols-2 gap-[60px] my-[10px] mb-[60px] items-stretch bg-white p-10 rounded-2xl shadow-sm border border-[#E6E6E6] relative z-[1]">
        <!-- Image -->
        <div class="project-image-section text-center">
          <div class="project-image w-full h-full bg-[#F6F6F6] rounded-lg border border-[#E6E6E6] flex items-center justify-center mx-auto relative overflow-hidden transition-all duration-300">
            {project.detailImage ? (
              <img src={project.detailImage} alt={project.title} class="project-detail-image w-full h-full object-cover rounded-lg" />
            ) : (
              <span class="image-size-hint text-[#BDBDBD] text-xl font-medium tracking-wider">No Image</span>
            )}
          </div>
        </div>

        <!-- Info -->
        <div class="project-info text-left">
          <p class="project-description text-lg leading-[1.8] text-[#6A6A6A] mb-10 font-normal">
            {project.description}
          </p>

          <div class="project-tech-stack mb-8">
            <h3 class="category-title text-xl font-bold text-[#2B2B2B] mb-5 flex items-center gap-2.5">
              <i class="fas fa-code text-[#5AA6B1]"></i> 技術棧
            </h3>
            <div class="tech-tags flex flex-wrap gap-2 justify-start items-center">
              {project.techStack.map((tech) => (
                <span class="tech-tag bg-[#F3F3F3] text-[#2B2B2B] px-4 py-2 rounded-full text-[0.85rem] font-medium transition-all duration-200 whitespace-nowrap hover:bg-[#E6E6E6]">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          {project.background && (
            <div class="project-background mb-10">
              <h3 class="category-title text-xl font-bold text-[#2B2B2B] mb-5 flex items-center gap-2.5">
                <i class="fas fa-info-circle text-[#5AA6B1]"></i> 專案背景
              </h3>
              <div class="background-content text-[#6A6A6A] leading-[1.8]" set:html={project.background} />
            </div>
          )}
        </div>
      </div>

      <!-- Process (Moved Up) -->
      {(project.process.design.length > 0 || project.process.development.length > 0) && (
        <div class="process-section mb-16">
          <h2 class="text-2xl font-bold text-[#2B2B2B] mb-8 pb-3 border-b border-[#E6E6E6]">開發流程</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {project.process.design.length > 0 && (
              <div class="process-card bg-white p-8 rounded-xl shadow-sm border border-[#E6E6E6]">
                <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
                  <h4 class="text-xl font-bold text-[#2B2B2B] flex items-center gap-3">
                    <span class="w-10 h-10 rounded-full bg-[#F3F3F3] flex items-center justify-center">
                      <i class="fab fa-figma text-[#7A66CC]"></i>
                    </span>
                    設計流程
                  </h4>
                  {project.links.figma && (
                    <a href={project.links.figma} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#F3F3F3] text-[#2B2B2B] px-4 py-2 rounded-full text-[0.85rem] font-medium transition-all duration-200 whitespace-nowrap hover:bg-[#E6E6E6] no-underline">
                      <i class="fab fa-figma"></i>
                      <span>Figma</span>
                    </a>
                  )}
                </div>
                
                {project.process.designImage && (
                  <div class="mb-8 rounded-lg overflow-hidden border border-[#E6E6E6]">
                    <img 
                      src={project.process.designImage} 
                      alt="Design Process" 
                      class="w-full h-auto object-cover hover:scale-[1.02] transition-transform duration-500"
                    />
                  </div>
                )}

                <div class="space-y-4">
                  {project.process.design.map((step) => (
                    <div class="flex gap-4">
                      <div class="w-1.5 h-1.5 rounded-full bg-[#5AA6B1] mt-2.5 flex-shrink-0"></div>
                      <p class="text-[#6A6A6A] leading-relaxed" set:html={step} />
                    </div>
                  ))}
                </div>
              </div>
            )}
            
            {project.process.development.length > 0 && (
              <div class="process-card bg-white p-8 rounded-xl shadow-sm border border-[#E6E6E6]">
                <h4 class="text-xl font-bold text-[#2B2B2B] mb-6 flex items-center gap-3">
                  <span class="w-10 h-10 rounded-full bg-[#F3F3F3] flex items-center justify-center">
                    <i class="fas fa-code text-[#5AA6B1]"></i>
                  </span>
                  開發流程
                </h4>

                {project.process.developmentImage && (
                  <div class="mb-8 rounded-lg overflow-hidden border border-[#E6E6E6]">
                    <img 
                      src={project.process.developmentImage} 
                      alt="Development Architecture" 
                      class="w-full h-auto object-cover hover:scale-[1.02] transition-transform duration-500"
                    />
                  </div>
                )}

                <div class="space-y-4">
                  {project.process.development.map((step) => (
                    <div class="flex gap-4">
                      <div class="w-1.5 h-1.5 rounded-full bg-[#5AA6B1] mt-2.5 flex-shrink-0"></div>
                      <p class="text-[#6A6A6A] leading-relaxed" set:html={step} />
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Challenges (Moved Up, Layout Changed) -->
      {project.challenges.length > 0 && (
        <div class="challenges-section mb-16">
          <h2 class="text-2xl font-bold text-[#2B2B2B] mb-8 pb-3 border-b border-[#E6E6E6]">技術挑戰與解決方案</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {project.challenges.map((challenge) => (
              <div class="challenge-card bg-white p-8 rounded-xl shadow-sm border border-[#E6E6E6]">
                <h4 class="text-xl font-bold text-[#2B2B2B] mb-4">{challenge.title}</h4>
                <div class="grid gap-4">
                  <div>
                    <span class="text-xs font-semibold text-[#5AA6B1] uppercase tracking-wider">情境</span>
                    <p class="text-[#6A6A6A] mt-1" set:html={challenge.situation} />
                  </div>
                  <div>
                    <span class="text-xs font-semibold text-[#5AA6B1] uppercase tracking-wider">困難點</span>
                    <p class="text-[#6A6A6A] mt-1" set:html={challenge.difficulty} />
                  </div>
                  <div>
                    <span class="text-xs font-semibold text-[#5AA6B1] uppercase tracking-wider">解決方案</span>
                    <p class="text-[#6A6A6A] mt-1" set:html={challenge.solution} />
                  </div>
                  <div>
                    <span class="text-xs font-semibold text-[#5AA6B1] uppercase tracking-wider">結果</span>
                    <p class="text-[#6A6A6A] mt-1" set:html={challenge.result} />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Highlights (Moved Down) -->
      {project.highlights.length > 0 && (
        <div class="highlights-section mb-16">
          <h2 class="text-2xl font-bold text-[#2B2B2B] mb-8 pb-3 border-b border-[#E6E6E6]">設計與技術亮點</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {project.highlights.map((highlight) => (
              <div class="highlight-card bg-white p-6 rounded-xl shadow-sm border border-[#E6E6E6] hover:shadow-md transition-shadow duration-300">
                {highlight.media && (
                  <div class="highlight-media mb-4 rounded-[10px] overflow-hidden bg-[#F6F6F6]">
                    {highlight.mediaType === 'video' ? (
                      <video src={highlight.media} controls autoplay muted loop playsinline class="w-full h-auto" preload="metadata">
                        您的瀏覽器不支援影片播放
                      </video>
                    ) : (
                      <img src={highlight.media} alt={highlight.title} class="w-full h-auto" />
                    )}
                  </div>
                )}
                <h4 class="text-lg font-bold text-[#2B2B2B] mb-2">{highlight.title}</h4>
                <p class="text-[#6A6A6A] text-sm leading-relaxed" set:html={highlight.description} />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Reflection -->
      {project.reflection.length > 0 && (
        <div class="reflection-section mb-16">
          <h2 class="text-2xl font-bold text-[#2B2B2B] mb-8 pb-3 border-b border-[#E6E6E6]">學習與反思</h2>
          <div class="bg-white p-8 rounded-xl shadow-sm border border-[#E6E6E6]">
            <ul class="space-y-4">
              {project.reflection.map((item) => (
                <li class="text-[#6A6A6A] flex items-start gap-4">
                  <span class="w-6 h-6 rounded-full bg-[#F3F3F3] flex items-center justify-center flex-shrink-0 mt-0.5">
                    <i class="fas fa-check text-xs text-[#BDBDBD]"></i>
                  </span>
                  <span class="leading-relaxed" set:html={item} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      <!-- Links -->
      <div class="project-links text-center mt-0 py-12 flex justify-center gap-4 flex-nowrap">
        {project.links.figma && (
          <a href={project.links.figma} target="_blank" rel="noopener noreferrer" class="bg-[#F3F3F3] text-[#2B2B2B] px-6 py-3 rounded-full text-sm font-medium inline-flex items-center justify-center gap-2 transition-all duration-200 no-underline hover:bg-[#E6E6E6]">
            <i class="fab fa-figma"></i>
            <span>Figma</span>
          </a>
        )}
        {project.links.github && (
          <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="bg-[#F3F3F3] text-[#2B2B2B] px-6 py-3 rounded-full text-sm font-medium inline-flex items-center justify-center gap-2 transition-all duration-200 no-underline hover:bg-[#E6E6E6]">
            <i class="fab fa-github"></i>
            <span>GitHub</span>
          </a>
        )}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Highlight 樣式 */
  .highlight, :global(.highlight) {
    font-weight: 600;
    background: rgba(122, 102, 204, 0.2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .project-content {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 20px;
      margin: 10px 10px 40px 10px;
      width: calc(100% - 20px);
      border-radius: 15px;
    }

    .section-title {
      font-size: 2.5rem;
    }

    .project-links {
      padding: 20px;
      gap: 10px;
      flex-wrap: wrap;
    }

    .project-links .btn {
      min-width: auto;
      width: 100%;
      max-width: none;
    }
  }
</style>
