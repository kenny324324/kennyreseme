---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import { projectDetails, getAllProjectSlugs, type ProjectDetail } from '../../data/projectDetails';

export function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map(slug => ({
    params: { slug },
    props: { project: projectDetails[slug] }
  }));
}

interface Props {
  project: ProjectDetail;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;

// 建立所有編號區塊的排序列表（固定 + 自訂）
type SectionEntry = { type: 'process' | 'challenges' | 'highlights' | 'reflection' | 'custom'; order: number; customIndex?: number };
const allSections: SectionEntry[] = [];

// 固定區塊（預設順序 1~4）
if (project.process.design.length > 0 || project.process.development.length > 0) {
  allSections.push({ type: 'process', order: 1 });
}
if (project.challenges.length > 0) {
  allSections.push({ type: 'challenges', order: 2 });
}
if (project.highlights.length > 0) {
  allSections.push({ type: 'highlights', order: 3 });
}
if (project.reflection.length > 0) {
  allSections.push({ type: 'reflection', order: 4 });
}

// 自訂區塊
project.customSections.forEach((cs, idx) => {
  if (cs.items.length > 0) {
    allSections.push({ type: 'custom', order: cs.order, customIndex: idx });
  }
});

// 按 order 排序
allSections.sort((a, b) => a.order - b.order);
---

<BaseLayout title={`${project.title} - 余亮廷 Kenny Yu`} description={project.description}>
  <Navbar showBackButton={true} />

  <main class="project-details pt-[100px] pb-[60px] bg-[#f5f5f5] min-h-screen">
    <div class="container max-w-[1200px] mx-auto px-5">

      <!-- Header -->
      <div class="section-header text-left mb-12 relative">
        <!-- Top row: eyebrow + App Store button -->
        <div class="flex items-center justify-between mb-4">
          <!-- 分類 eyebrow -->
          <div class="flex items-center gap-3">
            <div class="w-8 h-[2px] bg-[#C4873A]"></div>
            <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-[0.15em]">
              {project.techStack[0]}
            </span>
          </div>
          <!-- App Store / Google Play links -->
          <div class="flex items-center gap-3">
            {project.links.appstore && (
              <a href={project.links.appstore} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#263238] text-[#263238] text-xs font-semibold tracking-wide hover:bg-[#263238] hover:text-white transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 384 512" fill="currentColor">
                  <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
                </svg>
                App Store
              </a>
            )}
            {project.links.googleplay && (
              <a href={project.links.googleplay} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#263238] text-[#263238] text-xs font-semibold tracking-wide hover:bg-[#263238] hover:text-white transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 512 512" fill="currentColor">
                  <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/>
                </svg>
                Google Play
              </a>
            )}
          </div>
        </div>
        <h1 class="section-title text-[3rem] md:text-[3.5rem] font-bold text-[#263238] mb-2 tracking-tight leading-tight">
          {project.title}
        </h1>
        {project.subtitle && (
          <p class="text-xl text-[#3d4f5f] font-medium mb-5">{project.subtitle}</p>
        )}
        <!-- Tech tags row -->
        <div class="flex flex-wrap items-center gap-2 mt-4">
          <span class="text-[10px] font-semibold text-[#3d4f5f] uppercase tracking-wider mr-1">Tech Stack</span>
          {project.techStack.map((tech) => (
            <span class="text-[11px] font-medium text-[#3d4f5f] border border-[#cfd8dc] bg-white px-3 py-1 rounded-full">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Main Content -->
      <div class="project-content grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12 items-start bg-white p-10 rounded-lg border border-[#cfd8dc] relative z-[1]">
        <!-- Image -->
        <div class="project-image-section">
          <div class="aspect-[4/3] bg-[#eceff1] rounded-lg border border-[#cfd8dc] overflow-hidden">
            {project.detailImage ? (
              <img src={project.detailImage} alt={project.title} class="w-full h-full object-cover" />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="text-[#546e7a]/40 text-xl font-medium tracking-wider">No Image</span>
              </div>
            )}
          </div>
        </div>

        <!-- Info -->
        <div class="project-info text-left">
          <p class="project-description text-lg leading-[1.8] text-[#3d4f5f] mb-8 font-normal">
            {project.description}
          </p>

          {project.background && (
            <div class="project-background">
              <div class="flex items-center gap-2.5 mb-3">
                <i class="fas fa-info-circle text-[#C4873A] text-sm"></i>
                <h3 class="text-sm font-semibold text-[#263238] uppercase tracking-wider">專案背景</h3>
              </div>
              <div class="background-content text-[#3d4f5f] leading-[1.8] pl-[22px]" set:html={project.background} />
            </div>
          )}
        </div>
      </div>

      <!-- Numbered Sections (fixed + custom, sorted by order) -->
      {allSections.map((section, idx) => {
        const num = String(idx + 1).padStart(2, '0');

        if (section.type === 'process') return (
          <div class="process-section mb-12">
            <div class="flex items-baseline gap-3 mb-8 pb-4 border-b border-[#cfd8dc]">
              <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-widest">{num}</span>
              <h2 class="text-2xl font-bold text-[#263238]">開發流程</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {project.process.design.length > 0 && (
                <div class="process-card bg-white p-8 rounded-lg border border-[#cfd8dc]">
                  <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
                    <h4 class="text-lg font-bold text-[#263238] flex items-center gap-3">
                      <span class="w-8 h-8 rounded-lg bg-[#eceff1] flex items-center justify-center">
                        <i class="fab fa-figma text-[#546e7a] text-sm"></i>
                      </span>
                      設計流程
                    </h4>
                    {project.links.figma && (
                      <a href={project.links.figma} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-[#cfd8dc] text-[#3d4f5f] px-3 py-1.5 rounded-full text-[0.78rem] font-medium transition-all duration-200 whitespace-nowrap hover:border-[#546e7a] hover:text-[#263238] no-underline">
                        <i class="fab fa-figma text-xs"></i>
                        <span>Figma</span>
                      </a>
                    )}
                  </div>

                  {project.process.designImage && (
                    <div class="mb-6 rounded-lg overflow-hidden border border-[#cfd8dc]">
                      <img
                        src={project.process.designImage}
                        alt="Design Process"
                        class="w-full h-auto object-cover hover:scale-[1.02] transition-transform duration-500"
                      />
                    </div>
                  )}

                  <div class="space-y-3">
                    {project.process.design.map((step) => (
                      <div class="flex gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-[#C4873A] mt-2.5 flex-shrink-0"></div>
                        <p class="text-[#3d4f5f] leading-relaxed" set:html={step} />
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {project.process.development.length > 0 && (
                <div class="process-card bg-white p-8 rounded-lg border border-[#cfd8dc]">
                  <h4 class="text-lg font-bold text-[#263238] mb-6 flex items-center gap-3">
                    <span class="w-8 h-8 rounded-lg bg-[#eceff1] flex items-center justify-center">
                      <i class="fas fa-code text-[#546e7a] text-sm"></i>
                    </span>
                    開發流程
                  </h4>

                  {project.process.developmentImage && (
                    <div class="mb-6 rounded-lg overflow-hidden border border-[#cfd8dc]">
                      <img
                        src={project.process.developmentImage}
                        alt="Development Architecture"
                        class="w-full h-auto object-cover hover:scale-[1.02] transition-transform duration-500"
                      />
                    </div>
                  )}

                  <div class="space-y-3">
                    {project.process.development.map((step) => (
                      <div class="flex gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-[#C4873A] mt-2.5 flex-shrink-0"></div>
                        <p class="text-[#3d4f5f] leading-relaxed" set:html={step} />
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        );

        if (section.type === 'challenges') return (
          <div class="challenges-section mb-12">
            <div class="flex items-baseline gap-3 mb-8 pb-4 border-b border-[#cfd8dc]">
              <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-widest">{num}</span>
              <h2 class="text-2xl font-bold text-[#263238]">技術挑戰與解決方案</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {project.challenges.map((challenge) => (
                <div class="challenge-card bg-white p-7 rounded-lg border border-[#cfd8dc]">
                  <h4 class="text-lg font-bold text-[#263238] mb-5">{challenge.title}</h4>
                  <div class="space-y-4">
                    <div>
                      <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-wider">情境</span>
                      <p class="text-[#3d4f5f] mt-1 leading-relaxed" set:html={challenge.situation} />
                    </div>
                    <div class="pt-3 border-t border-[#eceff1]">
                      <span class="text-[10px] font-semibold text-[#546e7a] uppercase tracking-wider">困難點</span>
                      <p class="text-[#3d4f5f] mt-1 leading-relaxed" set:html={challenge.difficulty} />
                    </div>
                    <div class="pt-3 border-t border-[#eceff1]">
                      <span class="text-[10px] font-semibold text-[#546e7a] uppercase tracking-wider">解決方案</span>
                      <p class="text-[#3d4f5f] mt-1 leading-relaxed" set:html={challenge.solution} />
                    </div>
                    <div class="pt-3 border-t border-[#eceff1]">
                      <span class="text-[10px] font-semibold text-[#546e7a] uppercase tracking-wider">結果</span>
                      <p class="text-[#3d4f5f] mt-1 leading-relaxed" set:html={challenge.result} />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

        if (section.type === 'highlights') return (
          <div class="highlights-section mb-12">
            <div class="flex items-baseline gap-3 mb-8 pb-4 border-b border-[#cfd8dc]">
              <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-widest">{num}</span>
              <h2 class="text-2xl font-bold text-[#263238]">設計與技術亮點</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {project.highlights.map((highlight) => (
                <div class="highlight-card bg-white p-6 rounded-lg border border-[#cfd8dc] transition-colors duration-300 hover:border-[#546e7a]/40">
                  {highlight.media && (
                    <div class="highlight-media mb-4 rounded-lg overflow-hidden bg-[#eceff1]">
                      {highlight.mediaType === 'video' ? (
                        <video src={highlight.media} autoplay muted loop playsinline class="w-full h-auto" preload="metadata">
                          您的瀏覽器不支援影片播放
                        </video>
                      ) : (
                        <img src={highlight.media} alt={highlight.title} class="w-full h-auto" />
                      )}
                    </div>
                  )}
                  <h4 class="text-lg font-bold text-[#263238] mb-2">{highlight.title}</h4>
                  <p class="text-[#3d4f5f] leading-relaxed" set:html={highlight.description} />
                </div>
              ))}
            </div>
          </div>
        );

        if (section.type === 'reflection') return (
          <div class="reflection-section mb-12">
            <div class="flex items-baseline gap-3 mb-8 pb-4 border-b border-[#cfd8dc]">
              <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-widest">{num}</span>
              <h2 class="text-2xl font-bold text-[#263238]">學習與反思</h2>
            </div>
            <div class="bg-white p-8 rounded-lg border border-[#cfd8dc]">
              <ul class="space-y-4">
                {project.reflection.map((item) => (
                  <li class="text-[#3d4f5f] flex items-start gap-4">
                    <span class="w-5 h-5 rounded-full bg-[#C4873A]/10 border border-[#C4873A]/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                      <i class="fas fa-check text-[9px] text-[#C4873A]"></i>
                    </span>
                    <span class="leading-relaxed" set:html={item} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        );

        if (section.type === 'custom' && section.customIndex !== undefined) {
          const cs = project.customSections[section.customIndex];

          if (cs.style === 'cards') {
            return (
              <div class="custom-section mb-12">
                <div class="flex items-baseline gap-3 mb-8 pb-4 border-b border-[#cfd8dc]">
                  <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-widest">{num}</span>
                  <h2 class="text-2xl font-bold text-[#263238]">{cs.title}</h2>
                </div>
                <div class="review-scroll flex gap-5 overflow-x-auto pb-4 snap-x snap-mandatory">
                  {cs.items.map((item) => (
                    <div class="review-card flex-shrink-0 w-[300px] bg-white p-6 rounded-2xl border border-[#cfd8dc] snap-start">
                      <div class="flex items-center gap-1 mb-3">
                        {[1,2,3,4,5].map(() => (
                          <svg class="w-4 h-4 text-[#C4873A]" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                        ))}
                      </div>
                      <p class="text-[#3d4f5f] leading-relaxed text-[0.95rem]" set:html={item} />
                    </div>
                  ))}
                </div>
              </div>
            );
          }

          return (
            <div class="custom-section mb-12">
              <div class="flex items-baseline gap-3 mb-8 pb-4 border-b border-[#cfd8dc]">
                <span class="text-[10px] font-semibold text-[#C4873A] uppercase tracking-widest">{num}</span>
                <h2 class="text-2xl font-bold text-[#263238]">{cs.title}</h2>
              </div>
              <div class="bg-white p-8 rounded-lg border border-[#cfd8dc]">
                <ul class="space-y-4">
                  {cs.items.map((item) => (
                    <li class="text-[#3d4f5f] flex items-start gap-4">
                      <span class="w-5 h-5 rounded-full bg-[#C4873A]/10 border border-[#C4873A]/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class={`fas fa-${cs.icon} text-[9px] text-[#C4873A]`}></i>
                      </span>
                      <span class="leading-relaxed" set:html={item} />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        }
      })}

      <!-- Links -->
      {(project.links.figma || project.links.github) && (
        <div class="project-links mt-4 pt-8 border-t border-[#cfd8dc] flex items-center justify-between flex-wrap gap-4">
          <p class="text-sm text-[#3d4f5f]">對這個專案有興趣？</p>
          <div class="flex gap-3 flex-wrap">
            {project.links.figma && (
              <a href={project.links.figma} target="_blank" rel="noopener noreferrer" class="border border-[#cfd8dc] text-[#263238] px-5 py-2.5 rounded-full text-sm font-medium inline-flex items-center gap-2 transition-all duration-200 no-underline hover:border-[#546e7a] hover:text-[#546e7a] bg-white">
                <i class="fab fa-figma"></i>
                <span>Figma</span>
              </a>
            )}
            {project.links.github && (
              <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="border border-[#cfd8dc] text-[#263238] px-5 py-2.5 rounded-full text-sm font-medium inline-flex items-center gap-2 transition-all duration-200 no-underline hover:border-[#546e7a] hover:text-[#546e7a] bg-white">
                <i class="fab fa-github"></i>
                <span>GitHub</span>
              </a>
            )}
          </div>
        </div>
      )}

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Highlight 樣式 */
  .highlight, :global(.highlight) {
    font-weight: 600;
    background: rgba(196, 135, 58, 0.12);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  /* Review cards 水平捲動 */
  .review-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .review-scroll::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 768px) {
    .project-content {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 20px;
    }

    .section-title {
      font-size: 2.2rem;
    }
  }
</style>
