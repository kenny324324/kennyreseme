---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import { projectDetails, getAllProjectSlugs, type ProjectDetail } from '../../data/projectDetails';

export function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map(slug => ({
    params: { slug },
    props: { project: projectDetails[slug] }
  }));
}

interface Props {
  project: ProjectDetail;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${project.title} - 余亮廷 Kenny Yu`} description={project.description}>
  <Navbar />

  <main class="project-details pt-[100px] pb-[60px] bg-white min-h-screen">
    <div class="container max-w-[1200px] mx-auto px-5">
      <!-- Header -->
      <div class="section-header text-center mb-[60px] relative">
        <h1 class="section-title text-[3rem] md:text-[3.5rem] font-bold text-[#1a1a1a] mb-4 tracking-tight leading-tight bg-gradient-to-r from-[#1a1a1a] to-[#4a4a4a] bg-clip-text text-transparent">
          {project.title}
        </h1>
        <span class="project-category inline-block bg-gradient-to-r from-[#667eea] to-[#764ba2] text-white px-7 py-2.5 rounded-[30px] text-[0.9rem] font-medium tracking-wide shadow-[0_4px_15px_rgba(102,126,234,0.3)] uppercase">
          {project.categories.join(' / ')}
        </span>
      </div>

      <!-- Main Content -->
      <div class="project-content grid grid-cols-1 lg:grid-cols-2 gap-[60px] my-[10px] mb-[60px] items-stretch bg-white p-10 rounded-[30px] shadow-[0_4px_20px_rgba(0,0,0,0.06),0_8px_40px_rgba(0,0,0,0.04)] relative z-[1]">
        <!-- Image -->
        <div class="project-image-section text-center">
          <div class="project-image w-full h-full bg-[#f5f5f5] rounded-[10px] border border-[#e5e7eb] flex items-center justify-center mx-auto relative overflow-hidden transition-all duration-300">
            {project.coverImage ? (
              <img src={project.coverImage} alt={project.title} class="project-detail-image w-full h-full object-cover rounded-[10px]" />
            ) : (
              <span class="image-size-hint text-[#9ca3af] text-xl font-medium tracking-wider">No Image</span>
            )}
          </div>
        </div>

        <!-- Info -->
        <div class="project-info text-left">
          <p class="project-description text-lg leading-[1.8] text-[#4a5568] mb-10 font-normal">
            {project.description}
          </p>

          <div class="project-tech-stack mb-8">
            <h3 class="category-title text-xl font-bold text-[#1a1a1a] mb-5 flex items-center gap-2.5">
              <i class="fas fa-code"></i> 技術棧
            </h3>
            <div class="tech-tags flex flex-wrap gap-2 justify-start items-center">
              {project.techStack.map((tech) => (
                <span class="tech-tag bg-[#f8f9fa] text-[#6b7280] px-3 py-1.5 rounded-[15px] text-[0.85rem] font-normal border border-[#e5e7eb] transition-all duration-300 whitespace-nowrap font-mono">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          {project.background.myRole.length > 0 && (
            <div class="project-features mb-10">
              <h3 class="category-title text-xl font-bold text-[#1a1a1a] mb-5 flex items-center gap-2.5">
                <i class="fas fa-user"></i> 我的角色
              </h3>
              <ul class="features-list list-none p-0">
                {project.background.myRole.map((role) => (
                  <li class="py-5 text-[#4a5568] relative pl-11 font-normal border-b border-[#f1f5f9] transition-all duration-300 rounded-[10px] mb-2.5 before:content-['•'] before:absolute before:left-4 before:text-[#1a1a1a] before:font-bold before:text-2xl before:leading-none before:w-6 before:h-6 before:flex before:items-center before:justify-center">
                    {role}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>

      <!-- Highlights -->
      {project.highlights.length > 0 && (
        <div class="highlights-section mb-16">
          <h2 class="text-2xl font-bold text-[#1a1a1a] mb-8 pl-2 border-l-4 border-[#1a1a1a]">設計與技術亮點</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {project.highlights.map((highlight) => (
              <div class="highlight-card bg-white p-6 rounded-[20px] shadow-[0_4px_20px_rgba(0,0,0,0.08)] border border-gray-100">
                {highlight.media && (
                  <div class="highlight-media mb-4 rounded-[10px] overflow-hidden bg-gray-100">
                    {highlight.mediaType === 'video' ? (
                      <video src={highlight.media} controls class="w-full h-auto" preload="metadata">
                        您的瀏覽器不支援影片播放
                      </video>
                    ) : (
                      <img src={highlight.media} alt={highlight.title} class="w-full h-auto" />
                    )}
                  </div>
                )}
                <h4 class="text-lg font-bold text-[#1a1a1a] mb-2">{highlight.title}</h4>
                <p class="text-[#666] text-sm leading-relaxed">{highlight.description}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Challenges -->
      {project.challenges.length > 0 && (
        <div class="challenges-section mb-16">
          <h2 class="text-2xl font-bold text-[#1a1a1a] mb-8 pl-2 border-l-4 border-[#1a1a1a]">技術挑戰與解決方案</h2>
          <div class="space-y-6">
            {project.challenges.map((challenge) => (
              <div class="challenge-card bg-[#fafafa] p-8 rounded-[20px] border border-gray-100">
                <h4 class="text-xl font-bold text-[#1a1a1a] mb-4">{challenge.title}</h4>
                <div class="grid gap-4">
                  <div>
                    <span class="text-sm font-semibold text-[#667eea]">情境</span>
                    <p class="text-[#666] mt-1">{challenge.situation}</p>
                  </div>
                  <div>
                    <span class="text-sm font-semibold text-[#e53e3e]">困難點</span>
                    <p class="text-[#666] mt-1">{challenge.difficulty}</p>
                  </div>
                  <div>
                    <span class="text-sm font-semibold text-[#38a169]">解決方案</span>
                    <p class="text-[#666] mt-1">{challenge.solution}</p>
                  </div>
                  <div>
                    <span class="text-sm font-semibold text-[#3182ce]">結果</span>
                    <p class="text-[#666] mt-1">{challenge.result}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Process -->
      {(project.process.design.length > 0 || project.process.development.length > 0) && (
        <div class="process-section mb-16">
          <h2 class="text-2xl font-bold text-[#1a1a1a] mb-8 pl-2 border-l-4 border-[#1a1a1a]">開發流程</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {project.process.design.length > 0 && (
              <div class="process-card bg-white p-6 rounded-[20px] shadow-[0_4px_20px_rgba(0,0,0,0.08)] border border-gray-100">
                <h4 class="text-lg font-bold text-[#1a1a1a] mb-4 flex items-center gap-2">
                  <i class="fab fa-figma text-purple-600"></i> 設計流程
                </h4>
                <ol class="list-decimal list-inside space-y-2">
                  {project.process.design.map((step) => (
                    <li class="text-[#666] text-sm leading-relaxed">{step}</li>
                  ))}
                </ol>
              </div>
            )}
            {project.process.development.length > 0 && (
              <div class="process-card bg-white p-6 rounded-[20px] shadow-[0_4px_20px_rgba(0,0,0,0.08)] border border-gray-100">
                <h4 class="text-lg font-bold text-[#1a1a1a] mb-4 flex items-center gap-2">
                  <i class="fas fa-code text-blue-600"></i> 開發流程
                </h4>
                <ol class="list-decimal list-inside space-y-2">
                  {project.process.development.map((step) => (
                    <li class="text-[#666] text-sm leading-relaxed">{step}</li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Reflection -->
      {project.reflection.length > 0 && (
        <div class="reflection-section mb-16">
          <h2 class="text-2xl font-bold text-[#1a1a1a] mb-8 pl-2 border-l-4 border-[#1a1a1a]">學習與反思</h2>
          <div class="bg-gradient-to-r from-[#667eea]/5 to-[#764ba2]/5 p-8 rounded-[20px] border border-[#667eea]/20">
            <ul class="space-y-3">
              {project.reflection.map((item) => (
                <li class="text-[#4a5568] flex items-start gap-3">
                  <i class="fas fa-check-circle text-[#667eea] mt-1"></i>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      <!-- Links -->
      <div class="project-links text-center mt-0 p-12 bg-gradient-to-r from-white to-white rounded-[30px] flex justify-center gap-8 flex-nowrap">
        <a href={`${base}`} class="btn btn-secondary bg-[#f5f5f5] text-[#1a1a1a] min-w-[200px] px-9 py-4 text-base rounded-[30px] inline-flex items-center justify-center gap-3 transition-all duration-300 no-underline font-medium hover:bg-[#1a1a1a] hover:text-white hover:-translate-y-1 hover:shadow-lg">
          <i class="fas fa-arrow-left"></i>
          <span>返回首頁</span>
        </a>
        {project.links.figma && (
          <a href={project.links.figma} target="_blank" rel="noopener noreferrer" class="btn btn-primary bg-gradient-to-r from-[#667eea] to-[#764ba2] text-white min-w-[200px] px-9 py-4 text-base rounded-[30px] inline-flex items-center justify-center gap-3 transition-all duration-300 no-underline font-medium shadow-[0_5px_20px_rgba(102,126,234,0.3)] hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(102,126,234,0.4)]">
            <i class="fab fa-figma"></i>
            <span>Figma 設計稿</span>
          </a>
        )}
        {project.links.appstore && (
          <a href={project.links.appstore} target="_blank" rel="noopener noreferrer" class="btn btn-primary bg-gradient-to-r from-[#667eea] to-[#764ba2] text-white min-w-[200px] px-9 py-4 text-base rounded-[30px] inline-flex items-center justify-center gap-3 transition-all duration-300 no-underline font-medium shadow-[0_5px_20px_rgba(102,126,234,0.3)] hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(102,126,234,0.4)]">
            <i class="fab fa-apple"></i>
            <span>App Store</span>
          </a>
        )}
        {project.links.googleplay && (
          <a href={project.links.googleplay} target="_blank" rel="noopener noreferrer" class="btn btn-primary bg-gradient-to-r from-[#667eea] to-[#764ba2] text-white min-w-[200px] px-9 py-4 text-base rounded-[30px] inline-flex items-center justify-center gap-3 transition-all duration-300 no-underline font-medium shadow-[0_5px_20px_rgba(102,126,234,0.3)] hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(102,126,234,0.4)]">
            <i class="fab fa-google-play"></i>
            <span>Google Play</span>
          </a>
        )}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .project-content {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 20px;
      margin: 10px 10px 40px 10px;
      width: calc(100% - 20px);
      border-radius: 15px;
    }

    .section-title {
      font-size: 2.5rem;
    }

    .project-links {
      padding: 20px;
      gap: 10px;
      flex-wrap: wrap;
    }

    .project-links .btn {
      min-width: auto;
      width: 100%;
      max-width: none;
    }
  }
</style>
