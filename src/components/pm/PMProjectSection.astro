---
import { getPMProjects, getPMSupportProjects } from '../../data/pmProjects';
import { ui, type Language } from '../../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'zh-TW' } = Astro.props;
const text = ui[lang].pm;
const pmProjects = getPMProjects(lang);
const pmSupportProjects = getPMSupportProjects(lang);
---

<section id="pm-projects" class="pm-projects py-24 bg-[#faf9f5] border-y border-[#f0eee6]">
  <div class="w-full max-w-[1400px] mx-auto px-5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start">
        <p class="text-[13px] font-[590] text-[#c96442] uppercase tracking-[0.15em] mb-3">{text.eyebrow}</p>
        <h2 class="text-[48px] md:text-[56px] font-[600] text-[#141413] leading-[1] tracking-display mb-5">{text.title}</h2>
        <p class="text-[#5e5d59] leading-[1.6] text-[17px]">
          {text.description}
        </p>
      </div>

      <div class="lg:col-span-8">
        <div class="mb-7 pb-5 border-b border-[#e8e6dc]">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-5 h-px bg-[#c96442]"></div>
            <span class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em]">{text.currentScope}</span>
          </div>
          <p class="text-[18px] leading-[1.65] text-[#3d3d3a] max-w-[760px]">
            {text.currentScopeDescription}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {pmProjects.map((project) => (
            <article class="bg-[#faf9f5] p-6 border border-[#e8e6dc] shadow-[0_1px_2px_rgba(20,20,19,0.04)] transition-all duration-200 hover:shadow-[0_0_0_1px_#d1cfc5,0_4px_24px_rgba(20,20,19,0.05)] scroll-fade-in">
              <div class="mb-5">
                <div class="flex items-center gap-2.5 mb-2">
                  <span class="text-[10px] font-[590] text-[#c96442] uppercase tracking-[0.12em]">{project.type}</span>
                  <div class="h-px w-6 bg-black/[0.1]"></div>
                  <span class="text-[10px] text-[#87867f] font-[510]">{project.role}</span>
                </div>
                <h3 class="text-[25px] font-[600] text-[#141413] tracking-[-0.02em] leading-[1.25]">{project.title}</h3>
              </div>

              <p class="text-[#5e5d59] leading-[1.6] text-[16px] mb-5">{project.description}</p>

              <ul class="space-y-2 mb-5">
                {project.responsibilities.map((item) => (
                  <li class="text-[#5e5d59] leading-[1.55] pl-5 relative before:content-['▸'] before:absolute before:left-0 before:text-[#c96442] before:font-bold text-[15px]">
                    {item}
                  </li>
                ))}
              </ul>

              <div class="pt-4 border-t border-[#f0eee6]">
                <p class="text-[10px] font-[590] text-[#87867f] uppercase tracking-[0.12em] mb-2">{text.outputs}</p>
                <div class="flex flex-wrap gap-1.5">
                  {project.outputs.map((output) => (
                    <span class="text-[13px] font-[510] text-[#5e5d59] border border-[#e8e6dc] bg-[#faf9f5] px-2.5 py-1 rounded-none">
                      {output}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-6 pt-5 border-t border-[#e8e6dc]">
          <div class="bg-[#faf9f5] border border-[#e8e6dc] p-5 shadow-[0_1px_2px_rgba(20,20,19,0.03)]">
            <div>
              <h3 class="text-[21px] font-[600] text-[#141413] tracking-[-0.01em] mb-1">{text.supportTitle}</h3>
              {pmSupportProjects.map((item) => (
                <p class="text-[#5e5d59] leading-[1.6] text-[16px]">{item}</p>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
