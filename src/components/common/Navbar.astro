---
import { personalInfo } from '../../data/personal';

interface Props {
  showBackButton?: boolean;
}

const { showBackButton = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="navbar fixed top-0 left-0 right-0 w-full bg-[#faf9f5]/85 backdrop-blur-md border-b border-[#f0eee6] z-[1000]">
  <div class="nav-container max-w-[1400px] mx-auto px-6 grid grid-cols-[1fr_auto_1fr] items-center h-14 max-md:flex max-md:justify-between max-md:px-5">

    <!-- Logo / Back -->
    <div class="nav-logo justify-self-start flex items-center max-md:flex max-md:items-center">
      {showBackButton ? (
        <a href={`${base}/`} class="back-link no-underline text-[#141413] font-medium text-[15px] leading-none flex items-center gap-2 px-3 h-[32px] rounded-lg bg-black/[0.04] border border-[#e8e6dc] transition-all duration-200 hover:bg-black/[0.06] hover:border-[#e8e6dc]">
          <i class="fas fa-arrow-left text-[10px]"></i>
          <span>返回首頁</span>
        </a>
      ) : (
        <span class="logo-text text-[17px] font-semibold text-[#141413] leading-none tracking-[-0.01em]">{personalInfo.name.en}</span>
      )}
    </div>

    <!-- Nav Menu -->
    <ul class="nav-menu justify-self-center flex items-center list-none gap-0.5 max-md:fixed max-md:-left-full max-md:top-[56px] max-md:flex-col max-md:bg-[#faf9f5] max-md:w-[calc(100%-20px)] max-md:text-center max-md:transition-all max-md:duration-300 max-md:shadow-[0_8px_24px_rgba(20,20,19,0.08)] max-md:border max-md:border-[#f0eee6] max-md:py-4 max-md:gap-1 max-md:rounded-[14px] max-md:mx-2.5">
      <li class="flex items-center"><a href={`${base}#home`} class="nav-link no-underline text-[#5e5d59] font-[510] text-[15px] px-3 py-1.5 rounded-lg transition-all duration-200 relative hover:text-[#141413] hover:bg-black/[0.04]">首頁</a></li>
      <li class="flex items-center"><a href={`${base}#about`} class="nav-link no-underline text-[#5e5d59] font-[510] text-[15px] px-3 py-1.5 rounded-lg transition-all duration-200 relative hover:text-[#141413] hover:bg-black/[0.04]">關於我</a></li>
      <li class="flex items-center"><a href={`${base}#skills`} class="nav-link no-underline text-[#5e5d59] font-[510] text-[15px] px-3 py-1.5 rounded-lg transition-all duration-200 relative hover:text-[#141413] hover:bg-black/[0.04]">專業技能</a></li>
      <li class="flex items-center"><a href={`${base}#projects`} class="nav-link no-underline text-[#5e5d59] font-[510] text-[15px] px-3 py-1.5 rounded-lg transition-all duration-200 relative hover:text-[#141413] hover:bg-black/[0.04]">專案作品</a></li>
      <li class="flex items-center"><a href={`${base}#experience`} class="nav-link no-underline text-[#5e5d59] font-[510] text-[15px] px-3 py-1.5 rounded-lg transition-all duration-200 relative hover:text-[#141413] hover:bg-black/[0.04]">工作經歷</a></li>
      <li class="mobile-download-item hidden max-md:block">
        <a href={personalInfo.resumeUrl} class="download-btn flex items-center gap-2 no-underline text-[#faf9f5] font-[510] text-[15px] leading-none px-4 h-[36px] rounded-[10px] bg-[#141413] hover:bg-[#30302e] transition-all duration-200 max-md:inline-flex max-md:justify-center max-md:px-6 max-md:h-auto max-md:py-2.5 max-md:text-sm max-md:my-2 max-md:mx-auto max-md:w-fit">
          <i class="fas fa-download text-[10px]"></i>
          <span>下載履歷</span>
        </a>
      </li>
    </ul>

    <!-- Download CTA -->
    <div class="nav-actions justify-self-end flex items-center gap-3 max-md:hidden">
      <a href={personalInfo.resumeUrl} class="download-btn flex items-center gap-2 no-underline text-[#faf9f5] font-[510] text-[14px] leading-none px-5 h-[36px] rounded-[10px] bg-[#141413] hover:bg-[#30302e] transition-all duration-200 shadow-[0_1px_2px_rgba(20,20,19,0.15)]">
        <i class="fas fa-download text-[10px]"></i>
        <span>下載履歷</span>
      </a>
    </div>

    <div class="hamburger hidden flex-col justify-center items-center w-[30px] h-[30px] cursor-pointer p-[3px] max-md:flex max-md:ml-[15px]">
      <span class="block w-[22px] h-[2px] bg-[#141413] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
      <span class="block w-[22px] h-[2px] bg-[#141413] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
      <span class="block w-[22px] h-[2px] bg-[#141413] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
    </div>
  </div>
</nav>
