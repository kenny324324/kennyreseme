---
import { personalInfo } from '../../data/personal';

const base = import.meta.env.BASE_URL;
---

<nav class="navbar fixed top-5 left-1/2 -translate-x-1/2 w-[calc(100%-40px)] max-w-[1200px] bg-white/80 backdrop-blur-md rounded-[50px] z-[1000] transition-all duration-300 shadow-none md:w-[calc(100%-20px)] md:top-2.5 md:rounded-[20px] max-md:w-[calc(100%-20px)] max-md:top-2.5 max-md:rounded-[20px]">
  <div class="nav-container mx-auto px-8 grid grid-cols-[1fr_auto_1fr] items-center h-16 max-md:flex max-md:justify-between max-md:px-5">
    <div class="nav-logo justify-self-start flex flex-col items-start max-md:flex max-md:items-center">
      <span class="logo-text text-xl font-bold text-[#1a1a1a] leading-none">{personalInfo.name.en}</span>
      <span class="logo-subtitle text-[10px] text-[#666] font-normal -mt-0.5">{personalInfo.title.en}</span>
    </div>
    <ul class="nav-menu justify-self-center flex list-none gap-5 max-md:fixed max-md:-left-full max-md:top-[84px] max-md:flex-col max-md:bg-white max-md:w-[calc(100%-20px)] max-md:text-center max-md:transition-all max-md:duration-300 max-md:shadow-[0_10px_27px_rgba(0,0,0,0.1)] max-md:py-5 max-md:gap-2.5 max-md:rounded-[20px] max-md:mx-2.5">
      <li><a href={`${base}#home`} class="nav-link no-underline text-[#333] font-medium text-sm px-4 py-2 rounded-[20px] transition-all duration-300 relative hover:text-black hover:bg-black/10">首頁</a></li>
      <li><a href={`${base}#about`} class="nav-link no-underline text-[#333] font-medium text-sm px-4 py-2 rounded-[20px] transition-all duration-300 relative hover:text-black hover:bg-black/10">關於我</a></li>
      <li><a href={`${base}#skills`} class="nav-link no-underline text-[#333] font-medium text-sm px-4 py-2 rounded-[20px] transition-all duration-300 relative hover:text-black hover:bg-black/10">專業技能</a></li>
      <li><a href={`${base}#projects`} class="nav-link no-underline text-[#333] font-medium text-sm px-4 py-2 rounded-[20px] transition-all duration-300 relative hover:text-black hover:bg-black/10">專案作品</a></li>
      <li><a href={`${base}#experience`} class="nav-link no-underline text-[#333] font-medium text-sm px-4 py-2 rounded-[20px] transition-all duration-300 relative hover:text-black hover:bg-black/10">工作經歷</a></li>
      <li class="mobile-download-item hidden max-md:block">
        <a href={personalInfo.resumeUrl} class="download-btn flex items-center gap-2 no-underline text-[#333] font-semibold text-[13px] px-4 py-2 rounded-[25px] transition-all duration-300 bg-black/5 border-none hover:bg-[#1a1a1a] hover:text-white max-md:inline-flex max-md:justify-center max-md:px-6 max-md:py-3 max-md:text-sm max-md:my-2.5 max-md:mx-auto max-md:w-fit max-md:hover:bg-[#e2e8f0] max-md:hover:text-[#333]">
          <i class="fas fa-download text-xs max-md:text-sm"></i>
          <span>下載履歷</span>
        </a>
      </li>
    </ul>
    <div class="nav-actions justify-self-end -mr-4 flex items-center gap-[15px] max-md:hidden">
      <a href={personalInfo.resumeUrl} class="download-btn flex items-center gap-2 no-underline text-[#333] font-semibold text-[13px] px-4 py-2 rounded-[25px] transition-all duration-300 bg-black/5 border-none hover:bg-[#1a1a1a] hover:text-white">
        <i class="fas fa-download text-xs"></i>
        <span>下載履歷</span>
      </a>
    </div>
    <div class="hamburger hidden flex-col justify-center items-center w-[30px] h-[30px] cursor-pointer p-[3px] max-md:flex max-md:ml-[15px]">
      <span class="block w-[25px] h-[3px] bg-[#333] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
      <span class="block w-[25px] h-[3px] bg-[#333] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
      <span class="block w-[25px] h-[3px] bg-[#333] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
    </div>
  </div>
</nav>
