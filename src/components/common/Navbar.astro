---
import { personalInfo } from '../../data/personal';
import { getHomePath, getSectionPath, ui, type Language } from '../../i18n';
import LanguageToggle from '../ui/LanguageToggle.astro';

interface Props {
  showBackButton?: boolean;
  lang?: Language;
}

const { showBackButton = false, lang = 'zh-TW' } = Astro.props;
const base = import.meta.env.BASE_URL;
const text = ui[lang].nav;
const currentPath = Astro.url.pathname;
const navLinkClass = 'nav-link no-underline text-[#5e5d59] font-[510] text-[15px] px-3 py-1.5 transition-colors duration-200 relative max-md:block max-md:w-full max-md:px-0 max-md:py-1.5 max-md:text-[34px] max-md:leading-[1.12] max-md:font-[600] max-md:text-[#30302e]';
---

<nav transition:name="site-navbar" class="navbar fixed top-0 left-0 right-0 w-full bg-[#faf9f5] border-b-[1.5px] border-[#e8e6dc] z-[1000]">
  <div class="nav-container max-w-[1400px] mx-auto px-6 grid grid-cols-[1fr_auto_1fr] items-center h-14 max-md:flex max-md:justify-between max-md:px-5">

    <!-- Logo / Back -->
    <div class="nav-logo justify-self-start flex items-center max-md:flex max-md:items-center">
      {showBackButton ? (
        <a href={getHomePath(lang, base)} class="back-link no-underline text-[#141413] font-medium text-[15px] leading-none flex items-center gap-2 px-3 h-[32px] rounded-md bg-black/[0.04] border border-[#e8e6dc] transition-all duration-200 hover:bg-black/[0.06] hover:border-[#e8e6dc]">
          <i class="fas fa-arrow-left text-[10px]"></i>
          <span>{text.backHome}</span>
        </a>
      ) : (
        <a href={getSectionPath('home', lang, base)} class="logo-link flex items-center gap-2.5 no-underline leading-none">
          <img src={`${base}/avatar.png`} alt={personalInfo.name.en} class="logo-mark w-7 h-7 object-contain shrink-0 rounded-full" />
          <span class="logo-text font-serif text-[#141413] text-[22px] leading-[1.3] tracking-[-0.01em] whitespace-nowrap overflow-hidden max-w-0 opacity-0 -translate-x-1 transition-[max-width,opacity,transform] duration-300 ease-out py-0.5">{personalInfo.name.en}</span>
        </a>
      )}
    </div>

    <!-- Nav Menu -->
    <ul class="nav-menu justify-self-center flex items-center list-none gap-0.5 max-md:fixed max-md:left-0 max-md:top-14 max-md:bottom-0 max-md:z-[999] max-md:h-[calc(100dvh-56px)] max-md:w-screen max-md:flex-col max-md:items-start max-md:gap-4 max-md:bg-[#faf9f5] max-md:px-8 max-md:pt-12 max-md:pb-8 max-md:text-left max-md:border-t max-md:border-[#e8e6dc] max-md:overflow-y-auto">
      <li class="flex items-center max-md:w-full"><a href={getSectionPath('home', lang, base)} class={navLinkClass}>{text.home}</a></li>
      <li class="flex items-center max-md:w-full"><a href={getSectionPath('about', lang, base)} class={navLinkClass}>{text.about}</a></li>
      <li class="flex items-center max-md:w-full"><a href={getSectionPath('skills', lang, base)} class={navLinkClass}>{text.skills}</a></li>
      <li class="flex items-center max-md:w-full"><a href={getSectionPath('projects', lang, base)} class={navLinkClass}>{text.projects}</a></li>
      <li class="flex items-center max-md:w-full"><a href={getSectionPath('pm-projects', lang, base)} class={navLinkClass}>{text.pmProjects}</a></li>
      <li class="flex items-center max-md:w-full"><a href={getSectionPath('experience', lang, base)} class={navLinkClass}>{text.experience}</a></li>
      <li class="mobile-download-item hidden max-md:block max-md:w-full max-md:mt-auto max-md:pt-8 max-md:pb-1">
        <a href={personalInfo.resumeUrl} class="download-btn flex items-center gap-2 no-underline text-[#faf9f5] font-[510] text-[15px] leading-none px-4 h-[36px] rounded-md bg-[#141413] hover:bg-[#30302e] transition-all duration-200 max-md:flex max-md:w-full max-md:justify-center max-md:px-6 max-md:h-[54px] max-md:text-[17px] max-md:font-[560] max-md:my-0">
          <i class="fas fa-download text-[10px] max-md:text-[12px]"></i>
          <span>{text.resume}</span>
        </a>
      </li>
    </ul>

    <!-- Download CTA -->
    <div class="nav-actions justify-self-end flex items-center gap-3 max-md:hidden">
      <LanguageToggle currentLang={lang} currentPath={currentPath} />
      <a href={personalInfo.resumeUrl} class="download-btn flex items-center gap-2 no-underline text-[#faf9f5] font-[510] text-[13px] leading-none px-4 h-8 rounded-md bg-[#141413] hover:bg-[#30302e] transition-all duration-200 shadow-[0_1px_2px_rgba(20,20,19,0.15)]">
        <i class="fas fa-download text-[10px]"></i>
        <span>{text.resume}</span>
      </a>
    </div>

    <div class="mobile-nav-actions hidden items-center gap-2 max-md:ml-auto max-md:flex">
      <LanguageToggle currentLang={lang} currentPath={currentPath} />
      <button type="button" class="hamburger flex h-11 w-11 cursor-pointer flex-col items-center justify-center p-0 bg-transparent border-0" aria-label={text.menu}>
        <span class="pointer-events-none block w-[22px] h-[2px] bg-[#141413] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
        <span class="pointer-events-none block w-[22px] h-[2px] bg-[#141413] my-[2px] transition-all duration-300 rounded-[1px] origin-center relative"></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .navbar.scrolled .logo-text {
    max-width: 10rem;
    opacity: 1;
    transform: translateX(0);
  }
</style>
