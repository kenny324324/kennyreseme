---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex items-center gap-6 mb-16">
  <div class="flex-1 border-t border-dashed border-[#E6E6E6]"></div>
  <h2 class="text-4xl md:text-[2.4rem] font-semibold text-[#2B2B2B] whitespace-nowrap">{title}</h2>
  <div class="flex-1 border-t border-dashed border-[#E6E6E6]"></div>
</div>
