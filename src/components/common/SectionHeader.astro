---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<div class="mb-10">
  {eyebrow && (
    <p class="text-[13px] font-[590] text-[#c96442] uppercase tracking-[0.15em] mb-3">{eyebrow}</p>
  )}
  <div class="flex items-end justify-between gap-6 pb-5 border-b border-[#e8e6dc]">
    <h2 class="text-[48px] md:text-[56px] font-[600] text-[#141413] leading-[1] tracking-display">{title}</h2>
  </div>
</div>
