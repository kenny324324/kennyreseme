---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex items-center gap-6 mb-16">
  <div class="flex-1 border-t border-dashed border-[#cfd8dc]"></div>
  <h2 class="text-4xl md:text-[2.4rem] font-semibold text-[#263238] whitespace-nowrap">{title}</h2>
  <div class="flex-1 border-t border-dashed border-[#cfd8dc]"></div>
</div>
