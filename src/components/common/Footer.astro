---
import { personalInfo } from '../../data/personal';
---

<footer class="footer bg-[#faf9f5] text-[#5e5d59] py-12 border-t border-[#f0eee6]">
  <div class="w-full max-w-[1400px] mx-auto px-5">
    <div class="footer-content flex justify-between items-center flex-wrap gap-5 flex-col md:flex-row">
      <div class="footer-text flex-1">
        <p class="text-[15px] text-[#87867f] font-[510]">&copy; {new Date().getFullYear()} {personalInfo.name.zh} {personalInfo.name.en} · {personalInfo.title.zh}</p>
      </div>
      <div class="footer-social flex gap-2">
        <a href={`mailto:${personalInfo.email}`} class="social-link text-[#5e5d59] text-[17px] w-9 h-9 rounded-lg bg-black/[0.04] border border-[#e8e6dc] flex items-center justify-center no-underline transition-all duration-200 hover:bg-[#faebe0] hover:border-[#c96442]/30 hover:text-[#c96442]" aria-label="Email">
          <i class="fas fa-envelope"></i>
        </a>
        {personalInfo.github && (
          <a href={personalInfo.github} target="_blank" rel="noopener noreferrer" class="social-link text-[#5e5d59] text-[17px] w-9 h-9 rounded-lg bg-black/[0.04] border border-[#e8e6dc] flex items-center justify-center no-underline transition-all duration-200 hover:bg-[#faebe0] hover:border-[#c96442]/30 hover:text-[#c96442]" aria-label="GitHub">
            <i class="fab fa-github"></i>
          </a>
        )}
      </div>
    </div>
  </div>
</footer>
