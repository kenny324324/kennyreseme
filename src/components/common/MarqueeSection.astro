---
const base = import.meta.env.BASE_URL;

const images = [
  { src: `${base}/marquee/跳蛙公車.svg`, alt: '跳蛙公車' },
  { src: `${base}/marquee/TUAN.svg`, alt: 'TUAN' },
  { src: `${base}/marquee/取貨吧.svg`, alt: '取貨吧' },
  { src: `${base}/marquee/島嶼生吐司.svg`, alt: '島嶼生吐司' },
  { src: `${base}/marquee/Mish.svg`, alt: 'Mish' },
  { src: `${base}/marquee/FindToilet.svg`, alt: 'FindToilet' },
  { src: `${base}/marquee/Soulfeed.svg`, alt: 'Soulfeed' },
  { src: `${base}/marquee/Frame 235.svg`, alt: 'Frame 235' },
  { src: `${base}/marquee/Frame 236.svg`, alt: 'Frame 236' },
];
---

<div class="marquee-section overflow-hidden border-y border-[#e8e6dc] py-4 select-none">
  <div class="marquee-track flex">
    {[...images, ...images].map((img) => (
      <img
        src={img.src}
        alt={img.alt}
        class="marquee-item h-[50px] w-auto flex-shrink-0"
        draggable="false"
      />
    ))}
  </div>
</div>

<style>
  .marquee-section {
    cursor: grab;
  }
  .marquee-section.is-grabbing {
    cursor: grabbing;
  }

  .marquee-track {
    width: max-content;
    will-change: transform;
  }

  .marquee-item {
    margin-right: 80px;
    filter: grayscale(100%) brightness(1.05) contrast(0.8);
    opacity: 0.5;
    cursor: inherit;
  }
</style>

<script>
  const section = document.querySelector<HTMLDivElement>('.marquee-section');
  const track = section?.querySelector<HTMLDivElement>('.marquee-track');
  if (section && track) {
    let oneSetWidth = 0;
    let offset = 0;
    let isDragging = false;
    let startX = 0;
    let startOffset = 0;
    let lastTime = 0;
    const speed = 50; // px per second

    const calcWidth = () => {
      oneSetWidth = track.scrollWidth / 2;
    };

    const apply = () => {
      track.style.transform = `translate3d(${offset}px, 0, 0)`;
    };

    const wrap = () => {
      if (oneSetWidth <= 0) return;
      while (offset <= -oneSetWidth) offset += oneSetWidth;
      while (offset > 0) offset -= oneSetWidth;
    };

    const animate = (now: number) => {
      if (!lastTime) lastTime = now;
      const dt = (now - lastTime) / 1000;
      lastTime = now;

      if (!isDragging && oneSetWidth > 0) {
        offset -= speed * dt;
        wrap();
        apply();
      }
      requestAnimationFrame(animate);
    };

    // Wait for images so scrollWidth is accurate
    const imgs = Array.from(track.querySelectorAll('img'));
    Promise.all(
      imgs.map((img) =>
        img.complete
          ? Promise.resolve()
          : new Promise<void>((res) => {
              img.addEventListener('load', () => res(), { once: true });
              img.addEventListener('error', () => res(), { once: true });
            })
      )
    ).then(() => {
      calcWidth();
    });

    calcWidth();
    window.addEventListener('resize', calcWidth);
    requestAnimationFrame(animate);

    // Mouse drag
    section.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX;
      startOffset = offset;
      section.classList.add('is-grabbing');
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const dx = e.pageX - startX;
      offset = startOffset + dx;
      wrap();
      apply();
    });

    document.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      section.classList.remove('is-grabbing');
    });

    // Touch drag (only when horizontal intent is clear, so vertical page scroll stays)
    let touchStartY = 0;
    let touchLocked: 'none' | 'horizontal' | 'vertical' = 'none';

    section.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].pageX;
      touchStartY = e.touches[0].pageY;
      startOffset = offset;
      touchLocked = 'none';
    }, { passive: true });

    section.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const dx = e.touches[0].pageX - startX;
      const dy = e.touches[0].pageY - touchStartY;

      if (touchLocked === 'none') {
        if (Math.abs(dx) > 6 && Math.abs(dx) > Math.abs(dy)) {
          touchLocked = 'horizontal';
        } else if (Math.abs(dy) > 6) {
          touchLocked = 'vertical';
          isDragging = false;
          return;
        } else {
          return;
        }
      }

      if (touchLocked === 'horizontal') {
        e.preventDefault();
        offset = startOffset + dx;
        wrap();
        apply();
      }
    }, { passive: false });

    section.addEventListener('touchend', () => {
      isDragging = false;
      touchLocked = 'none';
    });
  }
</script>
