---
import SectionHeader from '../common/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { appProjects, systemProjects, systemProjectIcons } from '../../data/projects';

const companyProjects = appProjects.filter(p => !p.techStack.includes('自主學習'));
const personalProjects = appProjects.filter(p => p.techStack.includes('自主學習'));
---

<section id="projects" class="projects py-24 bg-[#faf9f5]">
  <div class="w-full max-w-[1400px] mx-auto px-5">
    <SectionHeader title="專案作品" eyebrow="Projects" />

    <!-- 商業專案 -->
    <div id="projects-commercial">
      <h3 class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em] mb-6 flex items-center gap-3">
        <div class="w-5 h-px bg-[#c96442]"></div>
        商業專案
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {companyProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>

    <!-- 自主學習 -->
    <div id="projects-personal">
      <h3 class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em] mb-6 flex items-center gap-3">
        <div class="w-5 h-px bg-[#c96442]"></div>
        自主學習
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {personalProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </div>

  <!-- 其他系統專案 -->
  <div id="projects-system" class="w-full max-w-[1400px] mx-auto px-5 mt-20">
    <h3 class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em] mb-6 flex items-center gap-3">
      <div class="w-5 h-px bg-[#c96442]"></div>
      其他系統專案
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {systemProjects.map((project) => (
        <ProjectCard project={project} icon={systemProjectIcons[project.slug]} />
      ))}
    </div>
  </div>
</section>
