---
import SectionHeader from '../common/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { getAppProjects, getSystemProjects, systemProjectIcons } from '../../data/projects';
import { ui, type Language } from '../../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'zh-TW' } = Astro.props;
const text = ui[lang].projects;
const appProjects = getAppProjects(lang);
const systemProjects = getSystemProjects(lang);
const personalProjectSlugs = new Set(['pickup', 'mish', 'findtoilets', 'mino', 'spostats', 'soulfeed']);
const companyProjects = appProjects.filter((p) => !personalProjectSlugs.has(p.slug));
const personalProjects = appProjects.filter((p) => personalProjectSlugs.has(p.slug));
const showSystemProjects = false;
---

<section id="projects" class="projects py-24 bg-[#faf9f5]">
  <div class="w-full max-w-[1400px] mx-auto px-5">
    <SectionHeader title={text.title} eyebrow={text.eyebrow} />

    <!-- 商業專案 -->
    <div id="projects-commercial">
      <h3 class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em] mb-6 flex items-center gap-3">
        <div class="w-5 h-px bg-[#c96442]"></div>
        {text.commercial}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {companyProjects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </div>

    <!-- 自主學習 -->
    <div id="projects-personal">
      <h3 class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em] mb-6 flex items-center gap-3">
        <div class="w-5 h-px bg-[#c96442]"></div>
        {text.personal}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {personalProjects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </div>
  </div>

  {showSystemProjects && (
    <!-- 其他系統專案：暫時隱藏，之後若要補，建議改成輕量案例卡，不套 App 詳情頁模板。 -->
    <div id="projects-system" class="w-full max-w-[1400px] mx-auto px-5 mt-20">
      <h3 class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em] mb-6 flex items-center gap-3">
        <div class="w-5 h-px bg-[#c96442]"></div>
        {text.system}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {systemProjects.map((project) => (
          <ProjectCard project={project} icon={systemProjectIcons[project.slug]} lang={lang} />
        ))}
      </div>
    </div>
  )}
</section>
