---
import SectionHeader from '../common/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { appProjects, systemProjects, systemProjectIcons } from '../../data/projects';

const companyProjects = appProjects.filter(p => !p.techStack.includes('自主學習'));
const personalProjects = appProjects.filter(p => p.techStack.includes('自主學習'));
---

<section id="projects" class="projects py-16 bg-[#f5f5f5]">
  <div class="w-full max-w-[1200px] mx-auto px-5">
    <SectionHeader title="專案作品" />

    <!-- 商業專案 -->
    <div id="projects-commercial">
      <h3 class="text-sm font-semibold text-[#66798f] uppercase tracking-[0.12em] mb-8 flex items-center gap-3">
        <div class="w-6 h-[2px] bg-[#66798f]"></div>
        商業專案
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
        {companyProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>

    <!-- 自主學習 -->
    <div id="projects-personal">
      <h3 class="text-sm font-semibold text-[#66798f] uppercase tracking-[0.12em] mb-8 flex items-center gap-3">
        <div class="w-6 h-[2px] bg-[#66798f]"></div>
        自主學習
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {personalProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </div>

  <!-- 其他系統專案 -->
  <div id="projects-system" class="w-full max-w-[1200px] mx-auto px-5 mt-20">
    <h3 class="text-sm font-semibold text-[#66798f] uppercase tracking-[0.12em] mb-8 flex items-center gap-3">
      <div class="w-6 h-[2px] bg-[#66798f]"></div>
      其他系統專案
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {systemProjects.map((project) => (
        <ProjectCard project={project} icon={systemProjectIcons[project.slug]} />
      ))}
    </div>
  </div>
</section>
