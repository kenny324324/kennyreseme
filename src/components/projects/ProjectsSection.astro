---
import SectionHeader from '../common/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { appProjects, systemProjects, systemProjectIcons } from '../../data/projects';
---

<section id="projects" class="projects py-16 bg-white">
  <div class="w-full max-w-[1200px] mx-auto px-5">
    <SectionHeader title="專案作品" />

    <!-- App Projects Grid -->
    <div class="projects-grid grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(350px,1fr))] gap-8">
      {appProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>

  <!-- Other System Projects -->
  <div class="w-full max-w-[1200px] mx-auto px-5">
    <div class="text-center mt-[60px] mb-16">
      <h3 class="section-subtitle text-[1.8rem] font-semibold text-[#1a1a1a] mb-2.5 text-center">其他系統專案</h3>
    </div>

    <div class="projects-grid grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(350px,1fr))] gap-8">
      {systemProjects.map((project) => (
        <ProjectCard project={project} icon={systemProjectIcons[project.slug]} />
      ))}
    </div>
  </div>
</section>
