---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  icon?: string;
}

const { project, icon } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="project-card group">
  <!-- 圖片區 -->
  <a href={`${base}/projects/${project.slug}`} class="block no-underline">
    <div class="relative aspect-[4/3] overflow-hidden border border-[#e8e6dc] mb-4 transition-all duration-300 group-hover:shadow-[0_0_0_1px_#d1cfc5,0_4px_24px_rgba(20,20,19,0.05)]">
      {project.coverImage ? (
        <img
          src={project.coverImage}
          alt={`${project.title}封面`}
          class="absolute inset-0 w-full h-full object-cover object-center transition-all duration-500 group-hover:scale-[1.02]"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-6xl text-[#b0aea5] bg-[#f3f4f5]">
          <i class={icon || 'fas fa-folder'}></i>
        </div>
      )}
      <!-- App Store / Google Play overlay -->
      {(project.links.appstore || project.links.googleplay) && (
        <div class="absolute top-3 right-3 flex gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          {project.links.appstore && (
            <a
              href={project.links.appstore}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 bg-[#faf9f5]/90 backdrop-blur-sm border border-[#f0eee6] rounded-md flex items-center justify-center text-[#141413] no-underline transition-all duration-200 hover:bg-[#faf9f5] hover:border-[#c96442]/40"
              title="App Store"
            >
              <i class="fab fa-apple text-[15px]"></i>
            </a>
          )}
          {project.links.googleplay && (
            <a
              href={project.links.googleplay}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 bg-[#faf9f5]/90 backdrop-blur-sm border border-[#f0eee6] rounded-md flex items-center justify-center text-[#141413] no-underline transition-all duration-200 hover:bg-[#faf9f5] hover:border-[#c96442]/40"
              title="Google Play"
            >
              <i class="fab fa-google-play text-[14px]"></i>
            </a>
          )}
        </div>
      )}
    </div>
  </a>

  <!-- 文字區 -->
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2.5 mb-2">
        <span class="text-[10px] font-[590] text-[#c96442] uppercase tracking-[0.12em]">
          {project.categories[0]}
        </span>
        <div class="h-px w-6 bg-black/[0.1] flex-shrink-0"></div>
        <span class="text-[10px] text-[#87867f] truncate font-[510]">{project.techStack[0]}</span>
      </div>
      <!-- 標題可點擊 -->
      <a href={`${base}/projects/${project.slug}`} class="no-underline">
        <h3 class="text-[25px] font-[600] text-[#141413] mb-1 leading-[1.25] tracking-[-0.02em] transition-colors duration-200 group-hover:text-[#c96442]">{project.title}</h3>
      </a>
      <p class="text-[15px] text-[#87867f] leading-[1.5] line-clamp-2">{project.description}</p>
    </div>
    <a
      href={`${base}/projects/${project.slug}`}
      class="flex-shrink-0 w-8 h-8 rounded-md border border-[#e8e6dc] flex items-center justify-center text-[#5e5d59] no-underline transition-all duration-200 hover:bg-[#141413] hover:border-[#141413] hover:text-[#faf9f5] mt-0.5"
    >
      <i class="fas fa-arrow-right text-[13px]"></i>
    </a>
  </div>
</div>
