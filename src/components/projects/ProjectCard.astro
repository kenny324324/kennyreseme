---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  icon?: string;
}

const { project, icon } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div
  class={`project-card bg-white rounded-[18px] overflow-hidden shadow-[0_8px_24px_-16px_rgba(43,43,43,0.2)] flex flex-col h-full group border border-[#E6E6E6] hover:border-[#DADADA] ${project.featured ? 'featured' : ''}`}
  data-category={project.categories.join(' ')}
>
  <div class="project-image relative h-[200px] bg-[#F6F6F6] flex items-center justify-center overflow-hidden">
    {project.coverImage ? (
      <img src={project.coverImage} alt={`${project.title}封面`} class="w-full h-full object-cover" />
    ) : (
      <div class="project-placeholder text-6xl text-[#E0E0E0]">
        <i class={icon || 'fas fa-folder'}></i>
      </div>
    )}
    <div class="project-overlay absolute inset-0 bg-[#2B2B2B]/20 backdrop-blur-sm flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover:opacity-100">
      <div class="project-links flex gap-4">
        {project.links.appstore && (
          <a
            href={project.links.appstore}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link w-[50px] h-[50px] bg-white/20 rounded-full flex items-center justify-center text-white no-underline text-lg transition-all duration-300 hover:bg-white/30 hover:scale-110"
            title="App Store"
          >
            <i class="fab fa-apple"></i>
          </a>
        )}
        {project.links.googleplay && (
          <a
            href={project.links.googleplay}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link w-[50px] h-[50px] bg-white/20 rounded-full flex items-center justify-center text-white no-underline text-lg transition-all duration-300 hover:bg-white/30 hover:scale-110"
            title="Google Play"
          >
            <i class="fab fa-google-play"></i>
          </a>
        )}
      </div>
    </div>
  </div>
  <div class="project-content p-6 flex-1 flex flex-col">
    <h3 class="project-title text-[1.25rem] font-semibold text-[#2B2B2B] mb-3">{project.title}</h3>
    <p class="project-description text-[#6A6A6A] leading-[1.7] mb-5 flex-1">{project.description}</p>
    <div class="project-tech flex flex-wrap gap-2 mb-5">
      {project.techStack.map((tech) => (
        <span class="tech-tag bg-white text-[#6A6A6A] px-3 py-1 rounded-[12px] text-[0.8rem] font-medium border border-[#E6E6E6]">{tech}</span>
      ))}
    </div>
    <a
      href={`${base}/projects/${project.slug}`}
      class="learn-more-btn bg-transparent text-[#2B2B2B] border border-[#2B2B2B] px-4 py-2 rounded-md text-[0.85rem] font-medium cursor-pointer transition-all duration-300 hover:bg-[#2B2B2B] hover:text-white w-full mt-auto text-center no-underline block"
    >
      了解更多
    </a>
  </div>
</div>
