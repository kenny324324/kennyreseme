---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  icon?: string;
}

const { project, icon } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="project-card group">
  <!-- 圖片區 -->
  <a href={`${base}/projects/${project.slug}`} class="block no-underline">
    <div class="relative aspect-[4/3] rounded-lg overflow-hidden border border-[#cfd8dc] mb-5 transition-all duration-300 group-hover:border-[#546e7a]/40">
      {project.coverImage ? (
        <img
          src={project.coverImage}
          alt={`${project.title}封面`}
          class="absolute inset-0 w-full h-full object-cover object-center transition-all duration-500 group-hover:brightness-90"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-6xl text-[#cfd8dc] bg-[#eceff1]">
          <i class={icon || 'fas fa-folder'}></i>
        </div>
      )}
      <!-- 精選 badge -->
      {project.featured && (
        <div class="absolute top-3 left-3 z-10">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#263238]/75 backdrop-blur-sm text-white text-[10px] font-semibold tracking-wider rounded-full">
            <i class="fas fa-star text-amber-400 text-[8px]"></i>
            精選
          </span>
        </div>
      )}
      <!-- App Store / Google Play overlay -->
      {(project.links.appstore || project.links.googleplay) && (
        <div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          {project.links.appstore && (
            <a
              href={project.links.appstore}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center text-[#263238] no-underline transition-all duration-300 hover:bg-white"
              title="App Store"
            >
              <i class="fab fa-apple text-sm"></i>
            </a>
          )}
          {project.links.googleplay && (
            <a
              href={project.links.googleplay}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center text-[#263238] no-underline transition-all duration-300 hover:bg-white"
              title="Google Play"
            >
              <i class="fab fa-google-play text-sm"></i>
            </a>
          )}
        </div>
      )}
    </div>
  </a>

  <!-- 文字區 -->
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-[10px] font-semibold text-[#3d4f5f] uppercase tracking-[0.12em]">
          {project.categories[0]}
        </span>
        <div class="h-[1px] w-8 bg-[#90a4ae]/40 flex-shrink-0"></div>
        <span class="text-[10px] text-[#3d4f5f] truncate">{project.techStack[0]}</span>
      </div>
      <!-- 標題可點擊 -->
      <a href={`${base}/projects/${project.slug}`} class="no-underline">
        <h3 class="text-lg font-semibold text-[#263238] mb-1.5 leading-tight transition-colors duration-300 group-hover:text-[#546e7a]">{project.title}</h3>
      </a>
      <p class="text-sm text-[#3d4f5f] leading-relaxed line-clamp-2">{project.description}</p>
    </div>
    <a
      href={`${base}/projects/${project.slug}`}
      class="flex-shrink-0 w-9 h-9 rounded-full border border-[#cfd8dc] flex items-center justify-center text-[#3d4f5f] no-underline transition-all duration-300 hover:bg-[#546e7a] hover:border-[#546e7a] hover:text-white mt-1"
    >
      <i class="fas fa-arrow-right text-xs"></i>
    </a>
  </div>
</div>
