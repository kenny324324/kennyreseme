---
import { skillCategories } from '../../data/skills';
---

<section id="skills" class="skills py-24 bg-[#faf9f5] relative border-y border-[#f0eee6]">
  <!-- Background Pattern -->
  <div class="absolute inset-0 skills-pattern pointer-events-none opacity-60"></div>

  <div class="w-full max-w-[1400px] mx-auto px-5 relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12">

      <!-- 左側：Sticky 標題 (1/3) -->
      <div class="w-full md:w-1/3 md:sticky md:top-32 md:self-start">
        <p class="text-[13px] font-[590] text-[#c96442] uppercase tracking-[0.15em] mb-3">Skills</p>
        <h2 class="text-[48px] md:text-[56px] font-[600] text-[#141413] leading-[1] tracking-display mb-5">專業技能</h2>
        <p class="text-[#5e5d59] leading-[1.6] text-[17px]">
          技能不只列工具，而是對應到實際做過的 App、系統與協作經驗，讓每項能力都有作品可以參照。
        </p>
      </div>

      <!-- 右側：技能分類 (2/3) -->
      <div class="w-full md:w-2/3">
        {skillCategories.map((category, catIndex) => (
          <div class={catIndex < skillCategories.length - 1 ? 'mb-10' : ''}>
            <h3 class="text-[13px] font-[590] text-[#87867f] uppercase tracking-[0.15em] mb-5 flex items-center gap-3">
              <div class="w-5 h-px bg-[#c96442]"></div>
              {category.title}
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {category.skills.map((skill) => (
                <div class="skill-card bg-[#faf9f5] p-5 rounded-none border border-[#e8e6dc] shadow-[0_1px_2px_rgba(20, 20, 19,0.03)] flex flex-col min-h-[245px]">
                  <div class="mb-4">
                    <div class="w-11 h-11 flex items-center justify-start flex-shrink-0">
                      {skill.brand ? (
                        <img
                          src={`https://cdn.simpleicons.org/${skill.brand}/${skill.iconColor.replace('#', '')}`}
                          alt={skill.name}
                          class="w-7 h-7"
                        />
                      ) : (
                        <i class={skill.icon} style={`color: ${skill.iconColor}; font-size: 28px;`}></i>
                      )}
                    </div>
                  </div>
                  <h4 class="text-[21px] font-[600] text-[#141413] mb-1 tracking-[-0.01em]">{skill.name}</h4>
                  <p class="text-[15px] text-[#87867f] leading-[1.5]">{skill.description}</p>
                  {skill.proof && (
                    <div class="mt-auto pt-4">
                      <p class="text-[10px] font-[590] text-[#87867f] uppercase tracking-[0.12em] mb-2">應用經驗</p>
                      <div class="flex flex-wrap gap-1.5">
                        {skill.proof.map((item) => (
                          <span class="text-[12px] font-[510] text-[#5e5d59] border border-[#e8e6dc] bg-[#faf9f5] px-2 py-1 rounded-none leading-none">
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
