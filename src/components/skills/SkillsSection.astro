---
import { skillCategories } from '../../data/skills';
---

<section id="skills" class="skills py-16 bg-[#f5f5f5] relative">
  <!-- Background Pattern -->
  <div class="absolute inset-0 skills-pattern pointer-events-none"></div>

  <div class="w-full max-w-[1200px] mx-auto px-5 relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-start gap-16">

      <!-- 左側：Sticky 標題 (1/3) -->
      <div class="w-full md:w-1/3 md:sticky md:top-32 md:self-start">
        <p class="text-[10px] font-semibold text-[#66798f] uppercase tracking-[0.15em] mb-3">Skills</p>
        <h2 class="text-4xl font-semibold text-[#263238] mb-5">專業技能</h2>
        <p class="text-[#66798f] leading-relaxed text-sm">
          橫跨跨平台開發、UI/UX 設計與 AI 整合的多元技術能力，持續精進以應對多變的產業需求。
        </p>
      </div>

      <!-- 右側：技能分類 (2/3) -->
      <div class="w-full md:w-2/3">
        {skillCategories.map((category, catIndex) => (
          <div class={catIndex < skillCategories.length - 1 ? 'mb-16' : ''}>
            <h3 class="text-sm font-semibold text-[#C4873A] uppercase tracking-[0.12em] mb-6 flex items-center gap-3">
              <div class="w-6 h-[2px] bg-[#C4873A]"></div>
              {category.title}
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {category.skills.map((skill) => (
                <div class="skill-card bg-white p-6 rounded-lg border border-[#cfd8dc]">
                  <div class="mb-5">
                    <div
                      class="w-12 h-12 rounded-lg bg-[#eceff1] flex items-center justify-center text-xl"
                      style={`color: ${skill.iconColor}`}
                    >
                      <i class={skill.icon}></i>
                    </div>
                  </div>
                  <h4 class="text-base font-bold text-[#263238] mb-2">{skill.name}</h4>
                  <p class="text-sm text-[#66798f] leading-relaxed">{skill.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
