---
import { personalInfo, stats } from '../../data/personal';

const base = import.meta.env.BASE_URL;
---

<section id="home" class="min-h-screen bg-[#f5f5f5] flex items-center relative overflow-hidden py-28 lg:py-0">
  <div class="w-full max-w-[1200px] mx-auto px-5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">

      <!-- 左側：文字 (7 欄) -->
      <div class="lg:col-span-7 space-y-10">
        <div>
          <p class="text-sm font-medium text-[#3d4f5f] uppercase tracking-[0.15em] mb-4">您好，我是</p>
          <h1 class="text-5xl lg:text-[4.5rem] font-bold text-[#263238] leading-[1.05] tracking-tight mb-4">
            {personalInfo.name.zh}<br class="hidden lg:block">{personalInfo.name.en}
          </h1>
          <h2 class="text-xl lg:text-2xl font-medium text-[#3d4f5f]">{personalInfo.title.zh}</h2>
        </div>

        <p class="text-lg leading-[1.85] text-[#3d4f5f] max-w-[520px]">
          具備 <span class="bg-[#C4873A]/12 px-1.5 py-0.5 rounded text-[#263238] font-medium">SwiftUI</span>、<span class="bg-[#C4873A]/12 px-1.5 py-0.5 rounded text-[#263238] font-medium">Flutter</span> 跨平台開發經驗，專精 <span class="bg-[#C4873A]/12 px-1.5 py-0.5 rounded text-[#263238] font-medium">.NET MAUI</span> 商業應用開發。
          善於運用 <span class="bg-[#C4873A]/12 px-1.5 py-0.5 rounded text-[#263238] font-medium">Figma</span> 進行 UI/UX 規劃設計，並整合 <span class="bg-[#C4873A]/12 px-1.5 py-0.5 rounded text-[#263238] font-medium">AI</span> 方案。
        </p>

        <div class="flex flex-wrap gap-4">
          <a href={`${base}#projects`} class="px-8 py-3.5 rounded-lg no-underline font-semibold text-base transition-all duration-300 bg-[#C4873A] text-white hover:bg-[#A8712E]">
            查看作品
          </a>
          <a href={`${base}#experience`} class="px-8 py-3.5 rounded-lg no-underline font-semibold text-base transition-all duration-300 border border-[#cfd8dc] bg-white text-[#263238] hover:border-[#546e7a] flex items-center gap-2">
            查看經歷 <i class="fas fa-arrow-right text-xs"></i>
          </a>
        </div>
      </div>

      <!-- 右側：大頭照 + 浮動玻璃卡 (5 欄) -->
      <div class="lg:col-span-5 relative">
        <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden border border-[#cfd8dc]">
          <img
            src={`${base}/profile.JPG`}
            alt={`${personalInfo.name.zh} ${personalInfo.name.en}`}
            class="w-full h-full object-cover object-top"
          />
          <!-- 浮動玻璃卡 -->
          <div class="absolute bottom-5 left-5 right-5 p-4 bg-white/85 backdrop-blur-xl rounded-lg border border-[#cfd8dc]">
            <!-- 狀態列 -->
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
                <span class="text-sm font-semibold text-[#263238]">Available for work</span>
              </div>
              <span class="text-[10px] text-[#3d4f5f] flex items-center gap-1">
                <i class="fas fa-location-dot text-[9px]"></i>
                台北，台灣
              </span>
            </div>
            <!-- 數據列 -->
            <div class="flex justify-between pt-3 border-t border-[#cfd8dc]">
              <div>
                <span class="text-lg font-bold text-[#263238]">{stats.years}+</span>
                <p class="text-[10px] text-[#3d4f5f] uppercase tracking-wider mt-0.5">Years Exp.</p>
              </div>
              <div>
                <span class="text-lg font-bold text-[#263238]">{stats.projects}+</span>
                <p class="text-[10px] text-[#3d4f5f] uppercase tracking-wider mt-0.5">Projects</p>
              </div>
              <div>
                <span class="text-lg font-bold text-[#263238]">3</span>
                <p class="text-[10px] text-[#3d4f5f] uppercase tracking-wider mt-0.5">Platforms</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
