---
import { personalInfo, stats } from '../../data/personal';
import { getAppProjects } from '../../data/projects';
import { getSectionPath, ui, type Language } from '../../i18n';
import MarqueeSection from '../common/MarqueeSection.astro';

interface Props {
  lang?: Language;
}

const { lang = 'zh-TW' } = Astro.props;
const base = import.meta.env.BASE_URL;
const hero = ui[lang].hero;
const localizedTitle = personalInfo.title[lang === 'en' ? 'en' : 'zh'];
const primaryName = lang === 'en' ? personalInfo.name.en : personalInfo.name.zh;
const secondaryName = lang === 'en' ? personalInfo.name.zh : personalInfo.name.en;
const appProjects = getAppProjects(lang);
const appProjectCount = appProjects.length;
const highlightClass = 'bg-[#faebe0] px-1.5 py-0.5 rounded text-[#b5623d] font-[590] whitespace-nowrap';
const heroDescription = hero.description
  .replaceAll('<mark>', `<span class="${highlightClass}">`)
  .replaceAll('</mark>', '</span>');
---

<section id="home" class="min-h-screen bg-[#faf9f5] flex flex-col relative overflow-hidden pt-28 lg:pt-0">
  <div class="flex-1 flex items-center w-full pb-16 lg:pb-0">
    <div class="w-full max-w-[1400px] mx-auto px-5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- 左側：文字 (7 欄) -->
      <div class="lg:col-span-7 space-y-8">
        <div>
          <p class="text-[13px] font-[590] text-[#c96442] uppercase tracking-[0.15em] mb-5">{hero.eyebrow}</p>
          <h1 class="text-[48px] min-[375px]:text-[56px] md:text-[64px] lg:text-[80px] font-[600] text-[#141413] leading-[1] tracking-display-xl mb-5">
            {primaryName}<br class="hidden lg:block"><span class="text-[#87867f]">{secondaryName}</span>
          </h1>
          <h2 class="text-[22px] lg:text-[24px] font-[600] text-[#5e5d59] tracking-[-0.01em]">{localizedTitle}</h2>
        </div>

        <p class="text-[19px] leading-[1.65] text-[#5e5d59] max-w-[560px]" set:html={heroDescription} />

      </div>

      <!-- 右側：橫式名片 (5 欄) -->
      <div class="lg:col-span-5 relative">
        <div class="bg-[#faf9f5] border border-[#e8e6dc] shadow-[0_1px_2px_rgba(20,20,19,0.04),0_8px_24px_rgba(20,20,19,0.06)] p-6 space-y-5">

          <!-- A. Header row：avatar + 名字/職稱 + 狀態 + 地點 -->
          <div class="flex items-center gap-5">
            <!-- Avatar 96x96 圓形 -->
            <img
              src={`${base}/profile.JPG`}
              alt={`${personalInfo.name.zh} ${personalInfo.name.en}`}
              class="w-24 h-24 rounded-full object-cover object-top border border-[#e8e6dc] flex-shrink-0"
            />

            <div class="flex-1 min-w-0">
              <!-- 狀態 -->
              <div class="inline-flex items-center gap-1.5 mb-2">
                <span class="relative flex items-center justify-center">
                  <span class="absolute w-2 h-2 bg-emerald-500/40 rounded-full animate-ping"></span>
                  <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full relative"></span>
                </span>
                <span class="text-[10px] font-[590] text-[#141413] uppercase tracking-[0.12em]">{hero.availability}</span>
              </div>

              <!-- 名字 -->
              <h3 class="text-[24px] font-[600] text-[#141413] leading-[1.15]">
                {primaryName} <span class="text-[#87867f]">{secondaryName}</span>
              </h3>
              <!-- 職稱 -->
              <p class="text-[13px] text-[#5e5d59] mt-0.5">
                {localizedTitle}
              </p>
              <!-- 地點 -->
              <p class="text-[12px] text-[#87867f] mt-1.5 flex items-center gap-1.5 font-[510]">
                <i class="fas fa-location-dot text-[10px] text-[#c96442]"></i>
                {hero.location}
              </p>
            </div>
          </div>

          <!-- B. 數據列 -->
          <div class="grid grid-cols-3 py-3 border-y border-[#f0eee6]">
            <div class="text-center">
              <div class="text-[20px] font-[600] text-[#141413] tracking-[-0.02em]">{stats.years}+</div>
              <p class="text-[9px] text-[#87867f] uppercase tracking-[0.12em] mt-0.5 font-[510]">{hero.stats.years}</p>
            </div>
            <div class="text-center border-l border-r border-[#f0eee6]">
              <div class="text-[20px] font-[600] text-[#141413] tracking-[-0.02em]">{appProjectCount}</div>
              <p class="text-[9px] text-[#87867f] uppercase tracking-[0.12em] mt-0.5 font-[510]">{hero.stats.projects}</p>
            </div>
            <div class="text-center">
              <div class="text-[20px] font-[600] text-[#141413] tracking-[-0.02em]">3</div>
              <p class="text-[9px] text-[#87867f] uppercase tracking-[0.12em] mt-0.5 font-[510]">{hero.stats.platforms}</p>
            </div>
          </div>

          <!-- C. 動作列 -->
          <div class="flex items-center gap-2">
            <a href={`mailto:${personalInfo.email}`} class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md bg-[#faf9f5] text-[#141413] text-[12px] font-[590] shadow-[0_0_0_1px_#e8e6dc] hover:shadow-[0_0_0_1px_#d1cfc5] hover:bg-black/[0.02] transition-all no-underline" aria-label="Email">
              <i class="fas fa-envelope text-[12px]"></i>
            </a>
            <a href={personalInfo.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md bg-[#faf9f5] text-[#141413] text-[12px] font-[590] shadow-[0_0_0_1px_#e8e6dc] hover:shadow-[0_0_0_1px_#d1cfc5] hover:bg-black/[0.02] transition-all no-underline" aria-label="GitHub">
              <i class="fab fa-github text-[14px]"></i>
            </a>
            <a href={getSectionPath('projects', lang, base)} class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md bg-[#141413] text-[#faf9f5] text-[12px] font-[590] shadow-[0_1px_2px_rgba(20,20,19,0.15),0_0_0_1px_#141413] hover:bg-[#30302e] transition-all no-underline">
              {hero.work}
            </a>
            <a href={getSectionPath('experience', lang, base)} class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md bg-[#faf9f5] text-[#141413] text-[12px] font-[590] shadow-[0_0_0_1px_#e8e6dc] hover:shadow-[0_0_0_1px_#d1cfc5] hover:bg-black/[0.02] transition-all no-underline">
              {hero.experience}
            </a>
          </div>

        </div>
      </div>

    </div>
    </div>
  </div>

  <MarqueeSection />
</section>
