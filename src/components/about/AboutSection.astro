---
import SectionHeader from '../common/SectionHeader.astro';
import { aboutParagraphs, stats } from '../../data/personal';
---

<section id="about" class="about py-16 bg-[#f5f5f5]">
  <div class="w-full max-w-[1200px] mx-auto px-5">
    <SectionHeader title="關於我" />

    <div class="about-content grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-12 items-center">
      <!-- Personal Intro -->
      <div class="personal-intro">
        {aboutParagraphs.zh.map((paragraph, index) => (
          <p class={`text-lg leading-[1.85] text-[#3d4f5f] ${index < aboutParagraphs.zh.length - 1 ? 'mb-5' : 'mb-0'}`}>
            {paragraph}
          </p>
        ))}
      </div>

      <!-- Stats -->
      <div class="about-stats grid grid-cols-1 gap-6">
        <div class="stat-item text-center p-8 bg-white rounded-lg border border-[#cfd8dc]">
          <div class="stat-number text-[3rem] font-bold text-[#263238] mb-1.5" data-stat="projects">{stats.projects}+</div>
          <div class="stat-label text-base font-medium text-[#3d4f5f]">App專案</div>
        </div>
        <div class="stat-item text-center p-8 bg-white rounded-lg border border-[#cfd8dc]">
          <div class="stat-number text-[3rem] font-bold text-[#263238] mb-1.5">{stats.years}</div>
          <div class="stat-label text-base font-medium text-[#3d4f5f]">工作年資</div>
        </div>
      </div>
    </div>
  </div>
</section>
